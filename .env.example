# Copy to .env. Non-secret settings only: API keys go in ./secrets/*.txt (see README).

# --- Postgres (pgvector) ---
POSTGRES_USER=podcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=podcast

# --- Object storage (RustFS in compose; any S3-compatible service works) ---
S3_ACCESS_KEY=podcast-admin
S3_SECRET_KEY=change-me-too
S3_BUCKET=podcast-episodes
S3_REGION=us-east-1

# --- Pipeline behaviour ---
# hashing = offline embeddings; or a 384-dimension sentence-transformers model id.
EMBEDDING_MODEL=hashing
# false = offline writer and fact-check (no key, no cost); true = LLM_PROVIDER writes and judges.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Another model to use while LLM_MODEL is overloaded (503) or out of today's quota; it has its
# own quota. Blank = always LLM_MODEL. Example: gemini-3.6-flash.
LLM_FALLBACK_MODEL=
# Claude only: thinking effort (low, medium, high, xhigh, max); blank = the model's default.
# Thinking is billed as output, so lower effort costs less.
LLM_EFFORT=
# placeholder (test tones) or gemini in containers; say or chatterbox on a host (see README).
TTS_BACKEND=placeholder
# With TTS_BACKEND=chatterbox, voicing runs on this machine (make voice-host), not in Docker
# (Docker on macOS cannot use the GPU). Uncomment so every docker compose command keeps the
# ports that worker uses:
# COMPOSE_FILE=docker-compose.yml:docker-compose.voice-host.yml
TTS_MODEL=gemini-3.8-flash-tts
# Gemini requests each model may make per Pacific day; 0 = not counted. Just under your daily
# caps (AI Studio, Rate limits), so a run stops cleanly before Gemini refuses it.
LLM_REQUESTS_PER_DAY=0
TTS_REQUESTS_PER_DAY=0
# Type-to-speech clips each person may make an hour (voice studio).
SPEECH_CLIPS_PER_HOUR=30
MAX_REWRITES=2
# Newest entries read from each RSS/Atom feed source, and the largest PDF upload.
FEED_MAX_ITEMS=10
MAX_UPLOAD_MB=25
# How long login tokens and API keys last, in days (six months).
AUTH_TOKEN_DAYS=180
# Failed-login limits: lock an account after this many in the window; slow an address after more.
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Sign in with Google: an OAuth client id (Google Cloud Console, type "Web application", redirect URI
# <PUBLIC_WEB_URL>/api/v1/auth/google/callback). Its secret goes in secrets/google_client_secret.txt.
GOOGLE_CLIENT_ID=
# Password-reset email. Blank SMTP_HOST in compose means Mailpit (local inbox on :8025).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_STARTTLS=
MAIL_FROM=Podcast Engine <no-reply@localhost>
# Links in emails are built from this, never from a request's Host header.
PUBLIC_WEB_URL=http://localhost:8080
# Hours between automatic refreshes of published shows (FR8); 0 = off. The Refresh button on a
# published episode does the same by hand, which suits the Gemini free tier better.
REFRESH_INTERVAL_HOURS=0
# Search results as a source (FR2): each of a show's searches reads this many top results.
# wikipedia needs no key; brave searches the whole web (paid) with its key in
# secrets/search_api_key.txt, stored in Vault by vault-init; off ignores searches.
SEARCH_PROVIDER=wikipedia
SEARCH_RESULTS=3
API_WORKERS=2
EPISODE_COST_CAP_USD=1.00

# --- Public URLs ---
PUBLIC_FEED_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
