# Copy to .env. Non-secret settings only: API keys go in ./secrets/*.txt (see README).

# --- Postgres (pgvector) ---
POSTGRES_USER=podcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=podcast

# --- Object storage (RustFS in compose; any S3-compatible service works) ---
S3_ACCESS_KEY=podcast-admin
S3_SECRET_KEY=change-me-too
S3_BUCKET=podcast-episodes
S3_REGION=us-east-1

# --- Pipeline behaviour ---
# hashing = offline embeddings; or a 384-dimension sentence-transformers model id.
EMBEDDING_MODEL=hashing
# false = offline writer and fact-check (no key, no cost); true = LLM_PROVIDER writes and judges.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Opt-in: another model to use if LLM_MODEL stays overloaded. Blank = always LLM_MODEL.
LLM_FALLBACK_MODEL=
# placeholder (test tones) or gemini in containers; say or chatterbox on a host (see README).
TTS_BACKEND=placeholder
TTS_MODEL=gemini-3.8-flash-tts
# Gemini requests each model may make per Pacific day; 0 = not counted. Just under your daily
# caps (AI Studio, Rate limits), so a run stops cleanly before Gemini refuses it.
LLM_REQUESTS_PER_DAY=0
TTS_REQUESTS_PER_DAY=0
MAX_REWRITES=2
# Newest entries read from each RSS/Atom feed source, and the largest PDF upload.
FEED_MAX_ITEMS=10
MAX_UPLOAD_MB=25
# How long login tokens and API keys last, in days (six months).
AUTH_TOKEN_DAYS=180
# Failed-login limits: lock an account after this many in the window; slow an address after more.
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Password-reset email. Blank SMTP_HOST in compose means Mailpit (local inbox on :8025).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_STARTTLS=
MAIL_FROM=Podcast Engine <no-reply@localhost>
# Links in emails are built from this, never from a request's Host header.
PUBLIC_WEB_URL=http://localhost:8080
# Hours between automatic refreshes of published shows (FR8); 0 = off.
REFRESH_INTERVAL_HOURS=0
API_WORKERS=2
EPISODE_COST_CAP_USD=1.00

# --- Public URLs ---
PUBLIC_FEED_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
