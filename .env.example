# Copy to .env. Non-secret settings only: API keys go in ./secrets/*.txt (see README).

# --- Postgres (pgvector) ---
POSTGRES_USER=podcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=podcast

# --- Object storage (MinIO, S3-compatible) ---
S3_ACCESS_KEY=minio-admin
S3_SECRET_KEY=change-me-too
S3_BUCKET=podcast-episodes

# --- Pipeline behaviour ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=claude-sonnet-5-5
TTS_PROVIDER=hosted
MAX_REWRITES=2
EPISODE_COST_CAP_USD=1.00

# --- Public URLs ---
PUBLIC_FEED_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
